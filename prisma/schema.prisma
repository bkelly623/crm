generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase ↔ Vercel integration sets POSTGRES_PRISMA_URL + POSTGRES_URL_NON_POOLING
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum UserRole {
  admin
  sales_manager
  hiring_manager
  sales_rep
  closer
  project_manager
  hybrid
  client
}

enum LeadSegment {
  active
  won
  trashed
}

enum LeadSource {
  native
  csv
  ghl
  manual
}

enum CallStatus {
  initiated
  ringing
  in_progress
  completed
  no_answer
  busy
  failed
  canceled
}

enum TaskStatus {
  open
  completed
  canceled
}

model Profile {
  id                    String   @id @db.Uuid
  email                 String   @unique
  fullName              String?  @map("full_name")
  role                  UserRole @default(sales_rep)
  phone                 String?
  timezone              String   @default("America/New_York")
  googleCalendarId      String?  @map("google_calendar_id")
  dialerHoursExtended   Boolean  @default(false) @map("dialer_hours_extended")
  twilioPhoneNumber     String?  @map("twilio_phone_number")
  ghlContactId          String?  @map("ghl_contact_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  assignedLeads Lead[] @relation("LeadSetter")
  closedLeads   Lead[] @relation("LeadCloser")
  calls         Call[]
  tasks         Task[]
  smartViews    SmartView[]
  leadLists     LeadList[]
  callIntents   CallIntent[]

  @@map("profiles")
}

model Lead {
  id              String      @id @default(cuid())
  businessName    String      @map("business_name")
  contactName     String?     @map("contact_name")
  phone           String?
  email           String?
  website         String?
  revenue         String?
  location        String?
  industry        String?
  sicCode         String?     @map("sic_code")
  market          String?
  type            String?
  source          LeadSource  @default(native)
  segment         LeadSegment @default(active)
  sdrStatus       String      @default("no_contact") @map("sdr_status")
  externalId      String?     @map("external_id")
  externalSource  String?     @map("external_source")
  notes           String?
  dialedCount     Int         @default(0) @map("dialed_count")
  setterId        String?     @map("setter_id") @db.Uuid
  closerId        String?     @map("closer_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  setter Profile? @relation("LeadSetter", fields: [setterId], references: [id], onDelete: SetNull)
  closer Profile? @relation("LeadCloser", fields: [closerId], references: [id], onDelete: SetNull)
  calls  Call[]
  tasks  Task[]

  tags  LeadTag[]
  lists LeadListMembership[]
  callIntents CallIntent[]

  @@index([segment])
  @@index([setterId])
  @@index([phone])
  @@index([externalId, externalSource])
  @@map("leads")
}

model Call {
  id              String     @id @default(cuid())
  leadId          String     @map("lead_id")
  userId          String     @map("user_id") @db.Uuid
  twilioCallSid   String?    @unique @map("twilio_call_sid")
  status          CallStatus @default(initiated)
  disposition     String?
  durationSeconds Int?       @map("duration_seconds")
  recordingUrl    String?    @map("recording_url")
  startedAt       DateTime   @default(now()) @map("started_at")
  endedAt         DateTime?  @map("ended_at")

  lead Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([leadId])
  @@map("calls")
}

model Task {
  id        String     @id @default(cuid())
  leadId    String     @map("lead_id")
  userId    String     @map("user_id") @db.Uuid
  note      String
  dueAt     DateTime   @map("due_at")
  status    TaskStatus @default(open)
  createdAt DateTime   @default(now()) @map("created_at")

  lead Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([status])
  @@map("tasks")
}

model SmartView {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  name      String
  filters   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("smart_views")
}

// Additive foundation only: SQL draft requires authorized staging review/application.
model Tag {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(60)
  nameKey   String   @unique @map("name_key") @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at")
  leads     LeadTag[]

  @@map("tags")
}

model LeadTag {
  leadId    String   @map("lead_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tagId])
  @@map("lead_tags")
}

model LeadList {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id") @db.Uuid
  name      String   @db.VarChar(80)
  nameKey   String   @map("name_key") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")
  owner     Profile  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leads     LeadListMembership[]

  @@unique([ownerId, nameKey])
  @@map("lead_lists")
}

model LeadListMembership {
  leadId    String   @map("lead_id")
  listId    String   @map("list_id")
  createdAt DateTime @default(now()) @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  list      LeadList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([leadId, listId])
  @@index([listId])
  @@map("lead_list_memberships")
}

// Intent + authoritative parent/child lifecycle. Native types ONLY on new tables.
// Local SQL drafts add binding/terminal-proof checks; RLS denies client access.
model CallIntent {
  id            String   @id @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  leadId        String   @map("lead_id")
  accountSid    String   @map("account_sid")
  callerIdSid   String   @map("caller_id_sid")
  callerNumber  String   @map("caller_number")
  destination   String
  state         String   @default("issued")
  parentCallSid String?  @unique @map("parent_call_sid")
  childCallSid  String?  @unique @map("child_call_sid")
  parentStatus  String?  @map("parent_status")
  childStatus   String?  @map("child_status")
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  user          Profile  @relation(fields: [userId], references: [id], onDelete: Restrict)
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  lease         CallIntentLease?

  @@unique([id, userId, leadId])
  @@map("call_intents")
}

model CallIntentLease {
  intentId String @id @map("intent_id") @db.Uuid
  userId   String @unique @map("user_id") @db.Uuid
  leadId   String @unique @map("lead_id")
  intent   CallIntent @relation(fields: [intentId, userId, leadId], references: [id, userId, leadId], onDelete: Restrict)

  @@unique([intentId, userId, leadId])
  @@map("call_intent_leases")
}

model OrgSettings {
  id              String  @id @default("default")
  ghlEnabled      Boolean @default(false) @map("ghl_enabled")
  ghlLocationId   String? @map("ghl_location_id")
  ghlApiKey       String? @map("ghl_api_key")
  useGhlCalendar  Boolean @default(false) @map("use_ghl_calendar")
  useGhlWorkflows Boolean @default(false) @map("use_ghl_workflows")

  @@map("org_settings")
}
